ANTHROPIC_API_KEY=
# Optional backup LLM (Gemini API free tier, aistudio.google.com/apikey). Used only when Anthropic
# rejects a call (bad key, credits, rate limit, outage). Unset = no fallback.
GEMINI_API_KEY=
VOYAGE_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=            # postgres direct connection string (for psql migrations)
NEXT_PUBLIC_MIXPANEL_TOKEN=  # Mixpanel project token (public/client-side); EU region — lib/analytics.ts pins the EU host
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RELEVANCE_THRESHOLD=0.32
DATA_DIR=../Data
